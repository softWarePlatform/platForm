{
  "name": "teaching-platform-judge-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/worker.js",
    "stop:worker": "node scripts/stop-worker.mjs",
    "db:generate": "node scripts/stop-worker.mjs && node scripts/ensure-prisma.mjs --force",
    "dev": "node scripts/ensure-prisma.mjs && tsx watch src/worker.ts",
    "test": "tsx src/runner.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "bullmq": "^5.43.0",
    "dotenv": "^16.4.7",
    "ioredis": "^5.6.0",
    "prisma": "^6.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}

# 独立作业成绩库；不要与单体 teaching_platform 或 course_service 共用。
# 本机 Docker Compose 默认映射 5433；若 A 的课程库在 55432，作业库仍用同一 Postgres 实例、不同库名。
DATABASE_URL=postgresql://platform:platform@127.0.0.1:5433/homework_grade_service?schema=public
PORT=3002
CORS_ORIGIN=http://localhost:5173,http://localhost:8080,http://localhost:30080
JWT_SECRET=replace-with-long-random-secret
INTERNAL_SERVICE_TOKEN=replace-with-service-token
COURSE_SERVICE_URL=http://localhost:3001
LAB_SERVICE_URL=http://localhost:3003
UPLOAD_DIR=./uploads
REQUEST_ID_HEADER=x-request-id

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum SubmissionStatus {
  PENDING
  JUDGING
  ACCEPTED
  WRONG_ANSWER
  ERROR
  TIMEOUT
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(STUDENT)
  avatarUrl    String?
  emailVerifiedAt DateTime?
  emailVerifyToken String?
  emailVerifyExpiresAt DateTime?
  passwordResetToken String?
  passwordResetExpiresAt DateTime?
  createdAt    DateTime @default(now())

  coursesTeaching       Course[]               @relation("TeacherCourses")
  enrollments           Enrollment[]
  submissions           Submission[]
  homeworkSubmissions   HomeworkSubmission[]
  homeworkQuestions     HomeworkQuestion[]
  discussionPosts       DiscussionPost[]
  announcementsAuthored CourseAnnouncement[]
  announcementReads     AnnouncementRead[]
  siteNotifications     SiteNotification[]
  materialFavorites       MaterialFavorite[]
  materialsUploaded     CourseMaterial[]       @relation("MaterialUploader")
  labFilesUploaded      LabFile[]
  answeredHomeworkQuestions HomeworkQuestion[] @relation("HomeworkQuestionAnsweredBy")
}

model Course {
  id                   String    @id @default(uuid())
  title                String
  description          String?
  category             String?
  teacherId            String
  published            Boolean   @default(false)
  createdAt            DateTime  @default(now())
  /** 总评权重：实验占比 + 作业占比 = 1 */
  labWeight            Float     @default(0.6)
  homeworkWeight       Float     @default(0.4)
  /** 开课 / 结课时间（用于展示与筛选） */
  startAt              DateTime?
  endAt                DateTime?
  /** 知识图谱 JSON：{ nodes:[{id,label}], edges:[{from,to,label?}] } */
  knowledgeGraphJson String?   @db.Text
  /** 周课表 JSON：[{ dayOfWeek, periodStart, periodEnd, room }] */
  scheduleSlotsJson  String?   @db.Text

  teacher           User             @relation("TeacherCourses", fields: [teacherId], references: [id], onDelete: Cascade)
  labs              Lab[]
  labSets           LabSet[]
  homeworks         Homework[]
  enrollments       Enrollment[]
  classes           Class[]
  discussionPosts   DiscussionPost[]
  materials         CourseMaterial[]
  announcements     CourseAnnouncement[]
}

model CourseAnnouncement {
  id              String   @id @default(uuid())
  courseId        String
  authorId        String
  title           String
  content         String   @db.Text
  pinned          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  editHistoryJson String?  @db.Text

  course        Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  author        User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reads         AnnouncementRead[]
  notifications SiteNotification[]

  @@index([courseId])
  @@index([courseId, pinned, createdAt])
}

model AnnouncementRead {
  id             String   @id @default(uuid())
  announcementId String
  userId         String
  readAt         DateTime @default(now())

  announcement CourseAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([userId])
}

model SiteNotification {
  id             String    @id @default(uuid())
  userId         String
  type           String    @default("ANNOUNCEMENT")
  title          String
  body           String?
  linkPath       String?
  announcementId String?
  materialId     String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  announcement CourseAnnouncement? @relation(fields: [announcementId], references: [id], onDelete: SetNull)
  material     CourseMaterial?     @relation(fields: [materialId], references: [id], onDelete: SetNull)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model CourseMaterial {
  id             String    @id @default(uuid())
  courseId       String
  title          String
  fileName       String
  storedPath     String
  mimeType       String?
  sizeBytes      Int
  uploadedById   String
  /** 目录路径，如「第1章/课件」，不含首尾斜杠 */
  folderPath     String    @default("")
  /** ALL | CLASS | TEACHER_ONLY */
  visibility     String    @default("ALL")
  targetClassId  String?
  pinned         Boolean   @default(false)
  /** 版本组：同组多版本 */
  groupId        String
  version        Int       @default(1)
  isCurrent      Boolean   @default(true)
  downloadCount  Int       @default(0)
  lastDownloadAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  course        Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  uploadedBy    User               @relation("MaterialUploader", fields: [uploadedById], references: [id], onDelete: Cascade)
  targetClass   Class?             @relation(fields: [targetClassId], references: [id], onDelete: SetNull)
  favorites     MaterialFavorite[]
  notifications SiteNotification[]

  @@index([courseId, isCurrent])
  @@index([courseId, folderPath])
  @@index([courseId, pinned, createdAt])
  @@index([groupId])
}

model MaterialFavorite {
  id         String   @id @default(uuid())
  userId     String
  materialId String
  createdAt  DateTime @default(now())

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  material CourseMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([userId, materialId])
  @@index([userId])
}

model Class {
  id       String @id @default(uuid())
  name     String
  courseId String

  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]
  homeworks   Homework[]
  materials   CourseMaterial[]
}

model Enrollment {
  id        String @id @default(uuid())
  userId    String
  courseId  String
  classId   String?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  class  Class?  @relation(fields: [classId], references: [id], onDelete: SetNull)

  @@unique([userId, courseId])
}

/** 实验集（综合实验）：一门课下可包含多道 Lab 题目 */
model LabSet {
  id          String    @id @default(uuid())
  courseId    String
  title       String
  description String?
  dueAt       DateTime?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  labs   Lab[]

  @@index([courseId])
}

model Lab {
  id             String  @id @default(uuid())
  courseId       String
  labSetId       String
  title          String
  description    String?
  /** Markdown 题干（与 description 并存；前端可优先渲染此字段） */
  descriptionMd  String? @db.Text
  language       String
  starterCode    String?

  course           Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  labSet           LabSet           @relation(fields: [labSetId], references: [id], onDelete: Cascade)
  testCases        TestCase[]
  submissions      Submission[]
  files            LabFile[]
  discussionPosts  DiscussionPost[]

  @@index([labSetId])
}

model LabFile {
  id           String   @id @default(uuid())
  labId        String
  title        String
  fileName     String
  storedPath   String
  mimeType     String?
  sizeBytes    Int
  uploadedById String
  createdAt    DateTime @default(now())

  lab        Lab  @relation(fields: [labId], references: [id], onDelete: Cascade)
  uploadedBy User @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([labId])
}

model TestCase {
  id       String @id @default(uuid())
  labId    String
  input    String
  expected String
  hidden   Boolean @default(false)
  weight   Int     @default(1)

  lab Lab @relation(fields: [labId], references: [id], onDelete: Cascade)
}

model Submission {
  id         String             @id @default(uuid())
  labId      String
  userId     String
  code       String
  status     SubmissionStatus   @default(PENDING)
  score      Float?
  resultJson String?
  createdAt  DateTime           @default(now())

  lab  Lab  @relation(fields: [labId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([labId])
  @@index([userId])
}

model Homework {
  id          String    @id @default(uuid())
  courseId    String
  targetClassId String?
  title       String
  description String?
  dueAt       DateTime?
  published   Boolean   @default(false)
  publishedAt DateTime?

  course      Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  targetClass Class?               @relation(fields: [targetClassId], references: [id], onDelete: SetNull)
  submissions HomeworkSubmission[]
  questions   HomeworkQuestion[]
}

model HomeworkSubmission {
  id          String   @id @default(uuid())
  homeworkId  String
  userId      String
  content     String
  score       Float?
  feedback    String?
  graded      Boolean  @default(false)
  released    Boolean  @default(false)
  releasedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  homework Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([homeworkId, userId])
}

model HomeworkQuestion {
  id         String   @id @default(uuid())
  homeworkId String
  userId     String
  question   String
  answer     String?
  answeredById String?
  createdAt  DateTime @default(now())
  answeredAt DateTime?

  homework Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  answeredBy User?  @relation("HomeworkQuestionAnsweredBy", fields: [answeredById], references: [id], onDelete: SetNull)

  @@index([homeworkId])
}

model DiscussionPost {
  id        String   @id @default(uuid())
  courseId  String
  /** 非空表示本题讨论帖；空表示课程级讨论 */
  labId     String?
  userId    String
  title     String
  body      String
  createdAt DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lab    Lab?   @relation(fields: [labId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([labId])
}

# 复制本文件为 .env 后按需修改。本地开发时 npm run dev 会自动加载（已集成 dotenv）。

# PostgreSQL（示例为本地默认端口；若用本机安装的数据库，请改用户名/密码/库名）
DATABASE_URL=postgresql://platform:platform@localhost:5432/teaching_platform?schema=public

# Redis（提交实验后评测入队依赖；仅浏览页面时可暂不启动 Redis，但点「提交评测」需要）
REDIS_URL=redis://127.0.0.1:6379

JWT_SECRET=dev-secret-change-in-prod
PORT=3000

# 本地前端 http://localhost:5173 时写 true 或留空即可；若需严格列表可写：
# CORS_ORIGIN=http://localhost:5173
CORS_ORIGIN=true

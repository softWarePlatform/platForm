# 复制本文件为 .env 后按需修改。本地开发时 npm run dev 会自动加载（已集成 dotenv）。
# 注意：每个 KEY=value 必须单独一行；勿把 REDIS_URL 与 JWT_SECRET 粘在同一行，否则 Redis 会报 SELECT NaN。

# PostgreSQL
# · 使用根目录 docker-compose.yml 的 db 服务时：宿主机端口为 5433（与 openGauss 等占用的 5432 错开）
# · 使用本机独立安装的 PostgreSQL 且为默认 5432 时：把下面端口改成 5432
DATABASE_URL=postgresql://platform:platform@localhost:5433/teaching_platform?schema=public

# Redis（提交实验后评测入队依赖；仅浏览页面时可暂不启动 Redis，但点「提交评测」需要）
REDIS_URL=redis://127.0.0.1:6379

JWT_SECRET=dev-secret-change-in-prod
PORT=3000
# 作业已迁到 homework-grade-service:3002。默认不在单体注册作业/成绩路由；对照旧实现时设为 1。
# MONOLITH_HOMEWORK_ROUTES=1
BODY_LIMIT_BYTES=2097152
RATE_LIMIT_MAX=600

# 本地前端 http://localhost:5173 时写 true 或留空即可；若需严格列表可写：
# CORS_ORIGIN=http://localhost:5173
CORS_ORIGIN=true

# —— 大模型（实验 AI 助手 / 作业批改 / 练习文档识题 共用，OpenAI 兼容接口）
# 配置后需重启 backend。任选一种方式取消注释并填写：
#
# DeepSeek（推荐）：
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
#
# 或 OpenAI 兼容别名：
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_MODEL=deepseek-chat
#
# 无云端密钥时，练习识题会默认请求本机 Ollama：http://127.0.0.1:11434/v1（需先 ollama serve && ollama pull llama3.2）
# AI_TIMEOUT_MS=60000
# AI_MAX_TOKENS=2048
# AI_RATE_LIMIT_MAX=20

# 课程资料上传目录（可选，默认 backend/uploads）
# UPLOAD_DIR=D:\\FWX\\platForm\\backend\\uploads

# 作业 AI 批改：后端请求 POST {BASE_URL}/chat/completions（OpenAI 兼容）。
# 你只要填「密钥 + 网关地址 + 模型名」三件套即可换任意厂商（含在线开源模型托管）。
#
# —— 在线开源 / 开源权重云端推理（无需自建机器；各平台注册后在控制台创建密钥与复制模型 ID）——
#
# 硅基流动 SiliconFlow（国内常用，多开源模型）
# AI_HOMEWORK_API_KEY=
# AI_HOMEWORK_BASE_URL=https://api.siliconflow.cn/v1
# AI_HOMEWORK_MODEL=（控制台复制，如 Qwen / Llama 等）
#
# OpenRouter（海外聚合，可选 Llama、Qwen、Mistral 等众多开源模型）
# AI_HOMEWORK_API_KEY=
# AI_HOMEWORK_BASE_URL=https://openrouter.ai/api/v1
# AI_HOMEWORK_MODEL=（控制台复制）
#
# Groq（Llama 等，延迟较低）
# AI_HOMEWORK_API_KEY=
# AI_HOMEWORK_BASE_URL=https://api.groq.com/openai/v1
# AI_HOMEWORK_MODEL=（控制台复制）
#
# Together AI / Fireworks / 火山方舟 / 阿里云百炼 等：同样填写该服务商文档里的 OpenAI 兼容 Base URL + Key + Model。
#
# —— 快捷别名（与 AI_HOMEWORK_* 等价，任选其一）——
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
#
# DEEPSEEK_API_KEY=
# DEEPSEEK_API_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
#
# —— 仅本机运行模型（Ollama，与「在线 API」二选一即可）——
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=llama3.2
# （局域网内其它机器的 Ollama 写 http://IP:11434/v1，必要时再加 AI_HOMEWORK_LOCAL_NO_AUTH=1）

# # 作业 AI 批改（DeepSeek，OpenAI 兼容接口）
# DEEPSEEK_API_KEY=
# DEEPSEEK_API_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

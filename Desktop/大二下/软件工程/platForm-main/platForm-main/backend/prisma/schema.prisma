generator client {
  provider = "prisma-client-js"
}

/** judge-worker 独立输出，避免与 API 争用 backend 下 query_engine DLL（Windows EPERM） */
generator judge_worker {
  provider = "prisma-client-js"
  output   = "../../judge-worker/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum SubmissionStatus {
  PENDING
  JUDGING
  ACCEPTED
  WRONG_ANSWER
  ERROR
  TIMEOUT
  PENDING_REVIEW
}

enum SubmissionKind {
  CODE
  FILE
}

enum JudgeMode {
  AUTO
  MANUAL
}

enum CourseNature {
  REQUIRED
  RENXIU
  ELECTIVE
}

enum SubjectCategory {
  MATH_BASIC
  ENGINEERING_BASIC
  FOREIGN_LANGUAGE
  PE
  QUALITY_EDU_THEORY
  QUALITY_EDU_PRACTICE
  CORE_MAJOR
  IDEOLOGY
  GENERAL_MAJOR
  CORE_GENERAL
}

enum EnrollmentPhase {
  PRESELECT
  FORMAL
  ADD_DROP
  CLOSED
}

enum EnrollmentLogAction {
  ENROLL
  DROP
  WAITLIST_JOIN
  WAITLIST_LEAVE
  WAITLIST_PROMOTED
  ADMIN_ENROLL
  ADMIN_DROP
  TIMETABLE_CONFIRM
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(STUDENT)
  avatarUrl    String?
  signature    String?
  emailVerifiedAt DateTime?
  emailVerifyToken String?
  emailVerifyExpiresAt DateTime?
  passwordResetToken String?
  passwordResetExpiresAt DateTime?
  disabledAt   DateTime?
  createdAt    DateTime @default(now())

  coursesTeaching       Course[]               @relation("TeacherCourses")
  enrollments           Enrollment[]
  submissions           Submission[]
  homeworkSubmissions   HomeworkSubmission[]
  homeworkQuestions     HomeworkQuestion[]
  discussionPosts       DiscussionPost[]
  discussionComments    DiscussionComment[]
  discussionAttachments DiscussionAttachment[]
  submissionsGraded     Submission[]           @relation("SubmissionGradedBy")
  announcementsAuthored CourseAnnouncement[]
  announcementReads     AnnouncementRead[]
  announcementMarks     AnnouncementMark[]
  siteNotifications     SiteNotification[]
  materialFavorites       MaterialFavorite[]
  materialsUploaded     CourseMaterial[]       @relation("MaterialUploader")
  labFilesUploaded      LabFile[]
  labReminderSents      LabReminderSent[]
  answeredHomeworkQuestions HomeworkQuestion[] @relation("HomeworkQuestionAnsweredBy")
  homeworkRevisions       HomeworkRevision[]
  homeworkRedoRequests    HomeworkRedoRequest[]
  reviewedHomeworkRedos   HomeworkRedoRequest[] @relation("HomeworkRedoReviewer")
  wrongBookEntries        WrongBookEntry[]
  practiceQuestionsCreated PracticeQuestion[] @relation("PracticeQuestionAuthor")
  practiceSessions        PracticeSession[]
  practiceFeedbacks       PracticeQuestionFeedback[]
  practiceFeedbacksResolved PracticeQuestionFeedback[] @relation("PracticeFeedbackResolver")
  enrollmentWaitlists     EnrollmentWaitlist[]
  enrollmentLogs          EnrollmentLog[]
  enrollmentLogsOperated  EnrollmentLog[]      @relation("EnrollmentLogOperator")
  timetableConfirmations  TimetableConfirmation[]
}

model Course {
  id                   String    @id @default(uuid())
  title                String
  description          String?
  category             String?
  teacherId            String
  published            Boolean   @default(false)
  createdAt            DateTime  @default(now())
  /** 总评权重：实验占比 + 作业占比 = 1 */
  labWeight            Float     @default(0.6)
  homeworkWeight       Float     @default(0.4)
  /** 开课 / 结课时间（用于展示与筛选） */
  startAt              DateTime?
  endAt                DateTime?
  /** 知识图谱 JSON：{ nodes:[{id,label}], edges:[{from,to,label?}] } */
  knowledgeGraphJson String?   @db.Text
  /** 周课表 JSON：[{ dayOfWeek, periodStart, periodEnd, room }] */
  scheduleSlotsJson  String?   @db.Text
  /** 选课系统：课程代码、学分、容量、性质与学科分类、学期 */
  courseCode         String?   @unique
  credits            Int       @default(2)
  capacity           Int       @default(60)
  courseNature         CourseNature    @default(ELECTIVE)
  subjectCategory      SubjectCategory @default(GENERAL_MAJOR)
  offeringCollegeCode  String?
  semesterKey          String          @default("2026-spring")

  teacher           User             @relation("TeacherCourses", fields: [teacherId], references: [id], onDelete: Cascade)
  labs              Lab[]
  labSets           LabSet[]
  homeworks         Homework[]
  enrollments       Enrollment[]
  classes           Class[]
  discussionPosts   DiscussionPost[]
  materials         CourseMaterial[]
  announcements     CourseAnnouncement[]
  waitlists         EnrollmentWaitlist[]
  enrollmentLogs    EnrollmentLog[]
  practiceQuestions      PracticeQuestion[]
  practiceSessions       PracticeSession[]
  practiceFeedbacks      PracticeQuestionFeedback[]
  practiceKnowledgeTags  PracticeKnowledgeTag[]
}

model PracticeKnowledgeTag {
  id        String   @id @default(uuid())
  courseId  String
  tagPath   String
  createdAt DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, tagPath])
  @@index([courseId])
}

model CourseAnnouncement {
  id              String   @id @default(uuid())
  courseId        String
  authorId        String
  title           String
  content         String   @db.Text
  pinned          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  editHistoryJson String?  @db.Text

  course        Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  author        User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reads         AnnouncementRead[]
  marks         AnnouncementMark[]
  notifications SiteNotification[]

  @@index([courseId])
  @@index([courseId, pinned, createdAt])
}

model AnnouncementMark {
  id             String   @id @default(uuid())
  announcementId String
  userId         String
  createdAt      DateTime @default(now())

  announcement CourseAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([userId])
}

model AnnouncementRead {
  id             String   @id @default(uuid())
  announcementId String
  userId         String
  readAt         DateTime @default(now())

  announcement CourseAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([userId])
}

model SiteNotification {
  id             String    @id @default(uuid())
  userId         String
  type           String    @default("ANNOUNCEMENT")
  title          String
  body           String?
  linkPath       String?
  announcementId String?
  materialId     String?
  homeworkId     String?
  labSetId       String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  announcement CourseAnnouncement? @relation(fields: [announcementId], references: [id], onDelete: SetNull)
  material     CourseMaterial?     @relation(fields: [materialId], references: [id], onDelete: SetNull)
  homework     Homework?           @relation(fields: [homeworkId], references: [id], onDelete: SetNull)
  labSet       LabSet?             @relation(fields: [labSetId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model CourseMaterial {
  id             String    @id @default(uuid())
  courseId       String
  title          String
  fileName       String
  storedPath     String
  mimeType       String?
  sizeBytes      Int
  uploadedById   String
  /** 目录路径，如「第1章/课件」，不含首尾斜杠 */
  folderPath     String    @default("")
  /** ALL | CLASS | TEACHER_ONLY */
  visibility     String    @default("ALL")
  targetClassId  String?
  pinned         Boolean   @default(false)
  /** 版本组：同组多版本 */
  groupId        String
  version        Int       @default(1)
  isCurrent      Boolean   @default(true)
  downloadCount  Int       @default(0)
  lastDownloadAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  course        Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  uploadedBy    User               @relation("MaterialUploader", fields: [uploadedById], references: [id], onDelete: Cascade)
  targetClass   Class?             @relation(fields: [targetClassId], references: [id], onDelete: SetNull)
  favorites     MaterialFavorite[]
  notifications SiteNotification[]

  @@index([courseId, isCurrent])
  @@index([courseId, folderPath])
  @@index([courseId, pinned, createdAt])
  @@index([groupId])
}

model MaterialFavorite {
  id         String   @id @default(uuid())
  userId     String
  materialId String
  createdAt  DateTime @default(now())

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  material CourseMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([userId, materialId])
  @@index([userId])
}

model Class {
  id       String @id @default(uuid())
  name     String
  courseId String

  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]
  homeworks   Homework[]
  materials   CourseMaterial[]
}

model Enrollment {
  id        String @id @default(uuid())
  userId    String
  courseId  String
  classId   String?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  class  Class?  @relation(fields: [classId], references: [id], onDelete: SetNull)

  @@unique([userId, courseId])
}

model EnrollmentWaitlist {
  id         String    @id @default(uuid())
  userId     String
  courseId   String
  createdAt  DateTime  @default(now())
  notifiedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId, createdAt])
}

model EnrollmentLog {
  id         String              @id @default(uuid())
  userId     String
  courseId   String
  action     EnrollmentLogAction
  operatorId String?
  note       String?
  createdAt  DateTime            @default(now())

  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course   Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  operator User?   @relation("EnrollmentLogOperator", fields: [operatorId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([courseId, createdAt])
}

model EnrollmentPeriod {
  id              String          @id @default(uuid())
  semesterKey     String          @unique
  label           String?
  phase           EnrollmentPhase @default(FORMAL)
  openAt          DateTime
  closeAt         DateTime
  confirmDeadline DateTime?
  updatedAt       DateTime        @updatedAt
}

model TimetableConfirmation {
  id          String   @id @default(uuid())
  userId      String
  semesterKey String
  confirmedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, semesterKey])
}

/** 实验集（综合实验）：一门课下可包含多道 Lab 题目 */
model LabSet {
  id          String    @id @default(uuid())
  courseId    String
  title       String
  description String?
  /** 开始时间；未设置则从创建时起算正式窗口 */
  startAt     DateTime?
  dueAt       DateTime?
  allowMakeup Boolean   @default(false)
  makeupDueAt DateTime?
  /** BLOCK：窗口外不可进入；VIEW_ONLY：可浏览不可提交 */
  outsideAccessMode String @default("BLOCK")
  sortOrder   Int       @default(0)
  /** 允许提交的文件扩展名，如 .py .cpp */
  allowedFileExtensions String[] @default([".py", ".js", ".ts", ".java", ".cpp", ".c", ".txt"])
  judgeMode           JudgeMode  @default(AUTO)
  /** 学生提交前可选语言列表 */
  allowedLanguages    String[]   @default(["python", "javascript"])
  /** 打回次数上限；null 表示不限制 */
  maxReturnCount      Int?
  createdAt   DateTime  @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  labs   Lab[]
  discussionPosts DiscussionPost[]
  reminderSents   LabReminderSent[]
  notifications   SiteNotification[]

  @@index([courseId])
}

/** 实验开始前/结束前 2h 提醒去重（每用户每实验集每类型仅发一次） */
model LabReminderSent {
  id       String   @id @default(uuid())
  labSetId String
  userId   String
  /** BEFORE_START | BEFORE_END */
  kind     String
  sentAt   DateTime @default(now())

  labSet LabSet @relation(fields: [labSetId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([labSetId, userId, kind])
  @@index([labSetId])
  @@index([userId])
}

model Lab {
  id             String  @id @default(uuid())
  courseId       String
  labSetId       String
  title          String
  description    String?
  /** Markdown 题干（与 description 并存；前端可优先渲染此字段） */
  descriptionMd  String? @db.Text
  language       String
  starterCode    String?
  /** 空则继承实验集 judgeMode */
  judgeMode      JudgeMode?
  allowedLanguages    String[] @default([])
  allowedFileExtensions String[] @default([])

  course           Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  labSet           LabSet           @relation(fields: [labSetId], references: [id], onDelete: Cascade)
  testCases        TestCase[]
  submissions      Submission[]
  files            LabFile[]
  discussionPosts  DiscussionPost[]

  @@index([labSetId])
}

model LabFile {
  id           String   @id @default(uuid())
  labId        String
  title        String
  fileName     String
  storedPath   String
  mimeType     String?
  sizeBytes    Int
  uploadedById String
  createdAt    DateTime @default(now())

  lab        Lab  @relation(fields: [labId], references: [id], onDelete: Cascade)
  uploadedBy User @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([labId])
}

model TestCase {
  id       String @id @default(uuid())
  labId    String
  input    String
  expected String
  hidden   Boolean @default(false)
  weight   Int     @default(1)

  lab Lab @relation(fields: [labId], references: [id], onDelete: Cascade)
}

model Submission {
  id              String           @id @default(uuid())
  labId           String
  userId          String
  submissionKind  SubmissionKind   @default(CODE)
  /** 评测语言（文件提交时由学生选择） */
  language        String?
  code            String           @default("")
  fileName        String?
  fileStoredPath  String?
  status          SubmissionStatus @default(PENDING)
  score           Float?
  resultJson      String?
  teacherComment  String?
  returnReason    String?
  returnCount     Int              @default(0)
  returnedAt      DateTime?
  gradedById      String?
  gradedAt        DateTime?
  createdAt       DateTime         @default(now())

  lab      Lab   @relation(fields: [labId], references: [id], onDelete: Cascade)
  user     User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  gradedBy User? @relation("SubmissionGradedBy", fields: [gradedById], references: [id], onDelete: SetNull)

  @@index([labId])
  @@index([userId])
}

enum HomeworkSubmissionType {
  INDIVIDUAL
  GROUP
}

enum HomeworkAnswerMode {
  RICH_TEXT
  FILE
  RICH_TEXT_OR_FILE
}

enum HomeworkRedoGradePolicy {
  REPLACE
  KEEP_MAX
}

enum HomeworkRedoRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model Homework {
  id          String    @id @default(uuid())
  courseId    String
  targetClassId String?
  title       String
  description String?
  /** Markdown 题干（富文本展示用 react-markdown） */
  descriptionMd String?
  dueAt       DateTime?
  published   Boolean   @default(false)
  publishedAt DateTime?

  allowLate   Boolean   @default(false)
  /** 每日扣减最高分的百分比，如 10 表示每日扣 10% */
  latePenaltyPercentPerDay Float?
  /** 超过该天数按 0 分计（如 3） */
  lateMaxDays Int?

  allowRedo   Boolean   @default(false)
  /** 1/3/5；null 且 allowRedo=false； -1 表示无限次 */
  maxRedoCount Int?

  submissionType HomeworkSubmissionType @default(INDIVIDUAL)
  maxGroupSize   Int?

  /** 学生作答方式 */
  answerMode           HomeworkAnswerMode @default(RICH_TEXT)
  allowMultipleSubmits Boolean            @default(false)
  requireAttachment    Boolean            @default(false)
  redoReasonRequired   Boolean            @default(false)
  redoGradePolicy      HomeworkRedoGradePolicy @default(KEEP_MAX)

  /** JSON: [{ name, maxScore }] */
  rubricJson  String?
  rubricStoredPath String?
  rubricFileName   String?

  /** 教师修改要求后更新，学生端提示「作业要求已更新」 */
  requirementsUpdatedAt DateTime?

  course      Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  targetClass Class?               @relation(fields: [targetClassId], references: [id], onDelete: SetNull)
  submissions   HomeworkSubmission[]
  questions     HomeworkQuestion[]
  attachments   HomeworkAttachment[]
  revisions     HomeworkRevision[]
  redoRequests  HomeworkRedoRequest[]
  notifications SiteNotification[]
}

model HomeworkAttachment {
  id         String   @id @default(uuid())
  homeworkId String
  fileName   String
  storedPath String
  mimeType   String?
  sizeBytes  Int
  createdAt  DateTime @default(now())

  homework Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)

  @@index([homeworkId])
}

model HomeworkRevision {
  id          String   @id @default(uuid())
  homeworkId  String
  userId      String
  summary     String
  snapshotJson String
  createdAt   DateTime @default(now())

  homework Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([homeworkId])
}

model HomeworkSubmission {
  id          String   @id @default(uuid())
  homeworkId  String
  userId      String
  content     String   @default("")
  draftContent String?
  requirementsReadAt DateTime?
  score       Float?
  feedback    String?
  graded      Boolean  @default(false)
  released    Boolean  @default(false)
  releasedAt  DateTime?
  /** 已正式提交且待批改/已批改未打回时锁定 */
  locked      Boolean  @default(false)
  submittedAt DateTime?
  returnReason String?
  returnCount Int      @default(0)
  redoUsedCount Int    @default(0)
  isLate      Boolean  @default(false)
  lateDays    Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  homework Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions HomeworkSubmissionVersion[]
  files    HomeworkStudentFile[]
  knowledgeAnalysis HomeworkKnowledgeAnalysis?

  @@unique([homeworkId, userId])
}

model HomeworkSubmissionVersion {
  id           String   @id @default(uuid())
  submissionId String
  version      Int
  content      String   @default("")
  submittedAt  DateTime @default(now())
  isLate       Boolean  @default(false)
  lateDays     Int?
  score        Float?
  feedback     String?
  graded       Boolean  @default(false)
  released     Boolean  @default(false)

  submission HomeworkSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  files      HomeworkStudentFile[]

  @@unique([submissionId, version])
  @@index([submissionId])
}

model HomeworkStudentFile {
  id           String   @id @default(uuid())
  submissionId String
  versionId    String?
  fileName     String
  storedPath   String
  mimeType     String?
  sizeBytes    Int
  createdAt    DateTime @default(now())

  submission HomeworkSubmission        @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  version    HomeworkSubmissionVersion?  @relation(fields: [versionId], references: [id], onDelete: SetNull)

  @@index([submissionId])
}

model HomeworkRedoRequest {
  id           String                  @id @default(uuid())
  homeworkId   String
  userId       String
  reason       String?
  status       HomeworkRedoRequestStatus @default(PENDING)
  rejectReason String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime                @default(now())

  homework   Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User?    @relation("HomeworkRedoReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([homeworkId, userId])
}

model HomeworkKnowledgeAnalysis {
  id           String   @id @default(uuid())
  submissionId String   @unique
  payloadJson  String   @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  submission HomeworkSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

enum PracticeQuestionType {
  CHOICE
  FILL
  SHORT_ANSWER
  CODE
}

enum PracticeDifficulty {
  EASY
  MEDIUM
  HARD
}

enum PracticeSessionMode {
  SMART
  BY_TAG
  WRONG_BOOK
  CUSTOM
}

enum PracticeSessionStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
}

enum PracticeFeedbackType {
  STEM_ERROR
  ANSWER_ERROR
  EXPLANATION_ERROR
  TOO_HARD
  TOO_EASY
  UNCLEAR
  SUGGEST_KNOWLEDGE
}

enum PracticeFeedbackStatus {
  PENDING
  FIXED
  REJECTED
  CLOSED
}

enum PracticeQuestionAuditStatus {
  APPROVED
  PENDING_REVIEW
}

enum PracticeAnswerSource {
  TEACHER
  AI
}

model PracticeQuestion {
  id            String                    @id @default(uuid())
  courseId      String
  type          PracticeQuestionType
  stem          String                    @db.Text
  optionsJson   String?                   @db.Text
  answerJson    String                    @db.Text
  explanation   String?                   @db.Text
  answerSource  PracticeAnswerSource      @default(TEACHER)
  answerConfirmed Boolean                 @default(true)
  tagPath       String
  difficulty    PracticeDifficulty        @default(MEDIUM)
  language      String?
  attemptCount  Int                       @default(0)
  correctCount  Int                       @default(0)
  totalTimeMs   Int                       @default(0)
  auditStatus   PracticeQuestionAuditStatus @default(APPROVED)
  createdById   String?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  course         Course                    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdBy      User?                     @relation("PracticeQuestionAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  sessionItems   PracticeSessionItem[]
  feedbacks      PracticeQuestionFeedback[]
  wrongBookLinks WrongBookEntry[]

  @@index([courseId, tagPath])
  @@index([courseId, difficulty])
}

model PracticeSession {
  id          String                @id @default(uuid())
  userId      String
  courseId    String
  mode        PracticeSessionMode
  tagFilter   String?
  configJson  String?               @db.Text
  status      PracticeSessionStatus @default(IN_PROGRESS)
  score       Float?
  maxScore    Int                   @default(0)
  submittedAt DateTime?
  gradedAt    DateTime?
  createdAt   DateTime              @default(now())

  user   User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course                @relation(fields: [courseId], references: [id], onDelete: Cascade)
  items  PracticeSessionItem[]

  @@index([userId, courseId])
}

model PracticeSessionItem {
  id           String   @id @default(uuid())
  sessionId    String
  questionId   String
  orderIndex   Int
  answerJson   String?  @db.Text
  correct      Boolean?
  score        Float?
  maxScore     Float    @default(1)
  resultJson   String?  @db.Text
  timeSpentMs  Int?
  aiHintCount  Int      @default(0)
  aiHintsJson  String?  @db.Text
  createdAt    DateTime @default(now())

  session  PracticeSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question PracticeQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, questionId])
  @@index([sessionId])
}

model PracticeQuestionFeedback {
  id             String                 @id @default(uuid())
  questionId     String
  courseId       String
  userId         String
  type           PracticeFeedbackType
  description    String                 @db.Text
  screenshotPath String?
  status         PracticeFeedbackStatus @default(PENDING)
  teacherReply   String?                @db.Text
  resolvedById   String?
  resolvedAt     DateTime?
  createdAt      DateTime               @default(now())

  question   PracticeQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  course     Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  resolvedBy User?            @relation("PracticeFeedbackResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([courseId, status])
  @@index([questionId])
}

model WrongBookEntry {
  id                 String   @id @default(uuid())
  userId             String
  courseId           String?
  homeworkId         String?
  practiceQuestionId String?
  title              String
  content            String   @db.Text
  mastered           Boolean  @default(false)
  createdAt          DateTime @default(now())

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  practiceQuestion PracticeQuestion? @relation(fields: [practiceQuestionId], references: [id], onDelete: SetNull)

  @@index([userId, mastered])
}

model HomeworkQuestion {
  id         String   @id @default(uuid())
  homeworkId String
  userId     String
  question   String
  answer     String?
  answeredById String?
  createdAt  DateTime @default(now())
  answeredAt DateTime?

  homework Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  answeredBy User?  @relation("HomeworkQuestionAnsweredBy", fields: [answeredById], references: [id], onDelete: SetNull)

  @@index([homeworkId])
}

model DiscussionPost {
  id        String   @id @default(uuid())
  courseId  String
  labSetId  String?
  /** 非空表示本题讨论帖；空表示课程级讨论 */
  labId     String?
  userId    String
  title     String
  body      String
  pinned    Boolean  @default(false)
  resolved  Boolean  @default(false)
  anonymous Boolean  @default(false)
  viewCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course   Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  labSet   LabSet?             @relation(fields: [labSetId], references: [id], onDelete: Cascade)
  lab      Lab?                @relation(fields: [labId], references: [id], onDelete: Cascade)
  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments DiscussionComment[]
  attachments DiscussionAttachment[]

  @@index([courseId])
  @@index([labId])
  @@index([labSetId])
}

model DiscussionComment {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  parentId  String?
  body      String
  anonymous Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post     DiscussionPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   DiscussionComment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies  DiscussionComment[] @relation("CommentThread")
  attachments DiscussionAttachment[]

  @@index([postId])
  @@index([parentId])
}

model DiscussionAttachment {
  id           String   @id @default(uuid())
  postId       String?
  commentId    String?
  fileName     String
  storedPath   String
  mimeType     String?
  sizeBytes    Int
  uploadedById String
  createdAt    DateTime @default(now())

  post       DiscussionPost?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment    DiscussionComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  uploadedBy User               @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([commentId])
}
